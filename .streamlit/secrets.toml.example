# Modelo de secrets.toml — NÃO é o arquivo real.
#
# Copie este arquivo para .streamlit/secrets.toml (mesma pasta) e preencha com
# valores reais. O secrets.toml real NUNCA deve ser commitado no git — já vai
# entrar no .gitignore quando a Camada 5 (deploy) for feita.

# Neon Postgres (Camada 1) — guarda só usuário/RBAC/justificativas/auditoria,
# não o warehouse (que continua em DuckDB local).
# Onde achar: console.neon.tech > seu projeto > Connection Details > Connection string
postgres_url = "postgresql://usuario:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# SMTP da Brevo (Camada 2, reset de senha) — mesmo padrão já usado em
# produção no MRS Sentinel. Gerar em: app.brevo.com > SMTP & API > SMTP.
# Pode reaproveitar a mesma credencial do MRS Sentinel ou gerar uma nova para
# isolar por projeto — sua escolha, não afeta o código.
[smtp]
host = "smtp-relay.brevo.com"
port = 587
usuario = "SUBSTITUA_PELO_LOGIN_SMTP_BREVO"
senha = "SUBSTITUA_PELA_CHAVE_SMTP_BREVO"
remetente = "painel-orcamento@SEU_DOMINIO_OU_SENDER_VERIFICADO"
